{
  "name": "sofa-platform",
  "version": "1.0.0",
  "description": "SOFA — The Future of Restaurant Experience Platform",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/dist/index.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:render": "prisma generate --schema server/prisma/schema.postgresql.prisma && npm run build:server && npm run build:client",
    "start:render": "node server/scripts/deploy-migrations.js && node server/dist/index.js",
    "build": "npm run db:push && npm run build:server && npm run build:client",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:push": "prisma db push --schema server/prisma/schema.prisma",
    "db:seed": "node --loader tsx server/src/seed.ts",
    "test": "vitest run",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "author": "SOFA Tech & Design Studio",
  "license": "ISC"
}
